authoritative;
option domain-name "linux.local";
option domain-name-servers 192.168.124.200, 192.168.124.201;
default-lease-time 600;
max-lease-time 7200;
# Dynamic DNS settings
dns-update-style standard;
dns-updates on;
ddns-domainname "linux.local.";
ddns-rev-domainname "in-addr.arpa.";
update-static-leases on;
DHCP failover peer
failover peer "dhcp-failover" {
secondary;
address 192.168.124.101;
port 647;
peer address 192.168.124.100;
peer port 647;
max-response-delay 60;
max-unacked-updates 10;
load balance max seconds 3;
}
# DHCP network
subnet 192.168.124.0 netmask 255.255.255.0 {
option routers 192.168.124.2;
option subnet-mask 255.255.255.0;
option domain-name "linux.local";
option domain-name-servers 192.168.124.200, 192.168.124.201;
pool {
failover peer "dhcp-failover";
range 192.168.124.10 192.168.124.50;
}
}
# Workstation reservation
ost 13s1h-wstation {
hardware ethernet 00:0c:29:ed:b7:b7;
fixed-address 192.168.124.90;
option host-name "13s1h-wstation";
ddns-hostname "13s1h-wstation";
}
